<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WarningLevel>5</WarningLevel>
    <NoWarn>1701;1702;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="18.1.0.4" />
    <PackageReference Include="ClangSharp.Interop" Version="18.1.0.4" />
    <PackageReference Include="ClangSharp.PInvokeGenerator" Version="18.1.0.4" />
    <PackageReference Include="libclang" Version="18.1.3.2" />
    <PackageReference Include="libClangSharp" Version="18.1.3.1" />
  </ItemGroup>

</Project>
